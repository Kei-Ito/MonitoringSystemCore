{
  "name": "@monitoring/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "pnpm exec tsc -p ./tsconfig.json && pnpm exec tsc-alias -p ./tsconfig.json",
    "clean": "pnpm exec tsc -b --clean",
    "rebuild": "pnpm run clean && pnpm run build"
  },
  "exports": {
    "./package.json": "./package.json",
    "./model": {
      "import": "./dist/types/model/index.js"
    },
    "./utils": {
      "import": "./dist/types/utils/index.js"
    },
    "./api": {
      "import": "./dist/types/api/index.js"
    },
    "./enum": {
      "import": "./dist/enum/index.js"
    }
  }
}