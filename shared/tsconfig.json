{
    "compilerOptions": {
      "composite": true,
      "target": "ES2022",
      "module": "ESNext",
      "moduleResolution": "bundler",
      "baseUrl": ".",
      "rootDir": "src",
      "outDir": "dist",
      "declaration": true,
      "noEmit": false,            // 必ず emit を許可
      "paths": {
         "@shared/*": ["src/*"]
      }
    },
    "include": ["src/**/*.ts"]
  }