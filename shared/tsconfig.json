{
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
      "composite": true,
      "baseUrl": ".",
      "rootDir": "src",
      "outDir": "dist",
      "declaration": true,
      "noEmit": false,            // 必ず emit を許可
      "paths": {
         "@shared/*": ["src/*"],
      }
    },
    "include": ["src/**/*.ts"]
  }