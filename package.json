{
  "name": "monitoring-core-service",
  "private": true,
  "packageManager": "pnpm@9.1.0",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm --filter ./apps/frontend... run dev & pnpm --filter ./apps/backend... run dev",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r test",
    "generate:barrels": "barrelsby -d shared/src --location all --delete"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.14.1",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "@vue/tsconfig": "^0.7.0",
    "barrelsby": "^2.8.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.26.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-vue": "^10.1.0",
    "globals": "^16.1.0",
    "nodemon": "^3.1.9",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.15",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.2",
    "vue-eslint-parser": "^10.1.3"
  }
}
