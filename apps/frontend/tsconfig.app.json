{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "composite": true,
    "allowImportingTsExtensions": true,  // ← ここだけ必要
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@monitoring/shared/*": ["../../shared/src/*"],
      
    }
  },
  "include": ["src/**/*.ts","src/**/*.js", "src/**/*.vue"],
  "exclude": [
    "src/assets/js/world.js"   // ← ここを追加
  ],
  "references": [{ "path": "../../shared" }]
}