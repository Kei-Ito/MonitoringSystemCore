{
  "name": "@monitoring/backend",
  "version": "0.0.0",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "pnpm exec tsc -p ./tsconfig.json && pnpm exec tsc-alias -p ./tsconfig.json",
    "dev": "pnpm tsx watch src/server.ts",
    "serve": "node dist/server.js",
    "start": "pnpm run serve",
    "lint": "pnpm exec tsc --noEmit  && eslint .",
    "fix": "eslint . --fix"
  },
  "dependencies": {
    "@monitoring/shared": "workspace:*",
    "axios": "^1.7.7",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "express": "^4.21.1",
    "mysql2": "^3.11.4",
    "uuid": "^10.0.0",
    "ws": "^8.18.0"
  }
}
