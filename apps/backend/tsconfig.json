{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "baseUrl": ".",
    "outDir": "dist",
    "esModuleInterop": true,
    "declaration": true,
    "paths": {      
      "src/*": ["src/*"],
      "@monitoring/shared/*": ["../../shared/src/*"]
    }
  },
  "ts-node": {
    "esm": true
  },
  "tsc-alias": {
    "resolveFullPaths": true,
    "resolveFullExtensions": true,//拡張子を追加するオプション
  },
  "include": ["src/**/*.ts"],
  "references": [{ "path": "../../shared" }]
}