{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "baseUrl": ".",
    "outDir": "dist",
    "declaration": true,
    "paths": {      
      "@/*": ["src/*"],            // srcディレクトリへのエイリアス
      "@monitoring/shared/*": ["../../shared/dist/*"], // sharedディレクトリへのエイリアス
    }
  },
  "include": ["src/**/*.ts"],
  "references": [{ "path": "../../shared" }]
}